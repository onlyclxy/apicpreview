<Window x:Class="PicViewEx.ImageSave.SaveAsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="另存为" Height="750" Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF2D2D30">

    <Window.Resources>
        <!-- 格式按钮样式 - 现代化设计 -->
        <Style x:Key="FormatButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF007ACC"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF007ACC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF00A0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF007ACC"/>
                    <Setter Property="BorderBrush" Value="#FF007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#FF252526" BorderBrush="#FF3E3E42"
                BorderThickness="0,0,0,1" Padding="20,15">
            <StackPanel>
                <TextBlock Text="另存为图片" FontSize="22" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="选择保存格式并配置参数" FontSize="13"
                           Foreground="#FFAAAAAA"/>
            </StackPanel>
        </Border>

        <!-- 图片预览区域 -->
        <Border Grid.Row="1" Background="#FF1E1E1E" BorderBrush="#FF3E3E42"
                BorderThickness="0,0,0,1" Padding="20" Margin="0">
            <StackPanel>
                <TextBlock Text="图片预览" FontSize="14" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,10"/>
                <Border Background="#FF252526" BorderBrush="#FF555555" 
                        BorderThickness="2" CornerRadius="5"
                        Width="300" Height="200" HorizontalAlignment="Center">
                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="ImageRotateTransform"/>
                        </Image.RenderTransform>
                    </Image>
                </Border>
                <TextBlock x:Name="RotationAngleText" Text="当前角度: 0°" 
                           Foreground="#FFAAAAAA" FontSize="11" 
                           Margin="0,8,0,0" HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- 格式选择区域 -->
        <Border Grid.Row="2" Background="#FF2D2D30" Padding="20">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="选择保存格式" FontSize="15" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Button x:Name="BtnPng" Content="PNG" Style="{StaticResource FormatButtonStyle}" Click="BtnPng_Click"/>
                    <Button x:Name="BtnJpg" Content="JPG" Style="{StaticResource FormatButtonStyle}" Click="BtnJpg_Click"/>
                    <Button x:Name="BtnBmp" Content="BMP" Style="{StaticResource FormatButtonStyle}" Click="BtnBmp_Click"/>
                    <Button x:Name="BtnTga" Content="TGA" Style="{StaticResource FormatButtonStyle}" Click="BtnTga_Click"/>
                    <Button x:Name="BtnDds" Content="DDS" Style="{StaticResource FormatButtonStyle}" Click="BtnDds_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 参数设置区域 -->
        <Border Grid.Row="3" Background="#FF252526" BorderBrush="#FF3E3E42"
                BorderThickness="0,1,0,0" Padding="20,15"
                Visibility="Collapsed" x:Name="OptionsPanel">
            <StackPanel>
                <!-- JPG质量设置 -->
                <StackPanel x:Name="JpgQualityPanel" Visibility="Collapsed">
                    <TextBlock Text="JPEG 压缩质量" Foreground="White" FontSize="15" 
                               FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="JpgQualitySlider" Grid.Column="0" Minimum="1" Maximum="100"
                                Value="85" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Height="30" 
                                ValueChanged="JpgQualitySlider_ValueChanged"/>
                        <Border Grid.Column="1" Background="#FF3E3E42" BorderBrush="#FF555555"
                                BorderThickness="1" CornerRadius="4" Margin="10,0,0,0">
                            <TextBox x:Name="JpgQualityTextBox" Text="85"
                                     FontSize="16" FontWeight="Bold" Padding="5" 
                                     Background="Transparent" Foreground="White"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center" TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- DDS预设设置 -->
                <StackPanel x:Name="DdsPresetPanel" Visibility="Collapsed">
                    <TextBlock Text="DDS 压缩选项" Foreground="White" FontSize="15" 
                               FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <!-- 按钮区域 - 双按钮横向布局 -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 自定义按钮 -->
                        <Button x:Name="BtnDdsCustom" Grid.Column="0" Content="自定义参数保存（NVIDIA UI）"
                                Height="40" Padding="12,8" FontSize="13"
                                Background="#FF3E3E42" Foreground="White"
                                BorderBrush="#FF555555" BorderThickness="1" Cursor="Hand"
                                Click="BtnDdsCustom_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FF3E3E42"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" 
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#FF007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- 复用参数按钮 -->
                        <Button x:Name="BtnDdsReuseParams" Grid.Column="2" Content="复用原始图片参数"
                                Height="40" Padding="12,8" FontSize="13"
                                Background="#FF3E3E42" Foreground="White"
                                BorderBrush="#FF555555" BorderThickness="1" Cursor="Hand"
                                Click="BtnDdsReuseParams_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FF3E3E42"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" 
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#FF00C853"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- 双列布局 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列:全部预设(带滚动) -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="全部预设" Foreground="#FF00D1B2"
                                       FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="AllPresetsList"/>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- 右列:常用预设 -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="HistoryHeader" Text="常用预设" Foreground="#FF00D1B2"
                                       FontSize="13" FontWeight="Bold" Margin="0,0,0,8" Visibility="Collapsed"/>
                            <ItemsControl x:Name="HistoryPresetsList"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
