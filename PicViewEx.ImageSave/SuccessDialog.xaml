<Window x:Class="PicViewEx.ImageSave.SuccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存成功" Width="550"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF2D2D30"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#FF4CAF50"
        BorderThickness="2">

    <Window.Resources>
        <!-- 按钮样式 -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SuccessButtonStyle}">
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF66BB6A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#FF1E1E1E" Padding="12,8" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 成功图标 -->
                <TextBlock Grid.Column="0" Text="✅" 
                           FontSize="16" FontWeight="Bold" 
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="#FF4CAF50"/>
                
                <!-- 标题 -->
                <TextBlock Grid.Column="1" Text="保存成功" 
                           FontSize="13" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <Border Grid.Row="1" Padding="15,12">
            <StackPanel>
                <!-- 成功消息 -->
                <TextBlock Text="文件已成功保存！" 
                           FontSize="14" 
                           Foreground="White" 
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                
                <!-- 文件路径显示 -->
                <Border Background="#FF1E1E1E" 
                        BorderBrush="#FF3E3E42" 
                        BorderThickness="1" 
                        Padding="10" 
                        CornerRadius="3"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="路径:" 
                                   FontSize="11" 
                                   Foreground="#FFAAAAAA" 
                                   VerticalAlignment="Top"
                                   Margin="0,0,8,0"/>
                        
                        <TextBlock x:Name="PathText" Grid.Column="1" 
                                   Text="" 
                                   FontSize="11" 
                                   Foreground="#FF4CAF50" 
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- 文件信息 -->
                <StackPanel x:Name="InfoPanel" Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="FileSizeText" Text="" 
                               FontSize="10" 
                               Foreground="#FFAAAAAA" 
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="FileFormatText" Text="" 
                               FontSize="10" 
                               Foreground="#FFAAAAAA"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 按钮区域 -->
        <Border Grid.Row="2" Background="#FF252526" Padding="12,10" BorderBrush="#FF3E3E42" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnOpenFolder" 
                            Content="📁 打开文件夹" 
                            Width="120"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnOpenFolder_Click"/>
                    
                    <Button x:Name="BtnCopyPath" 
                            Content="📋 复制路径" 
                            Width="100"
                            Style="{StaticResource SuccessButtonStyle}"
                            Click="BtnCopyPath_Click"/>
                </StackPanel>

                <!-- 右侧关闭按钮 -->
                <Button Grid.Column="1" 
                        Content="关闭" 
                        Width="90"
                        Style="{StaticResource SuccessButtonStyle}"
                        IsDefault="True"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

