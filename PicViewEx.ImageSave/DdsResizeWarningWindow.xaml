<Window x:Class="PicViewEx.ImageSave.DdsResizeWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DDS尺寸警告 - 选择目标分辨率" Height="750" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF2D2D30">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ResolutionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF007ACC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF007ACC"/>
                    <Setter Property="BorderBrush" Value="#FF00D1B2"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 警告标题和预览 -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：警告信息 -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="⚠ DDS尺寸警告" FontSize="22" FontWeight="Bold"
                           Foreground="#FFFFB74D" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtCurrentSize" FontSize="14" Foreground="White" 
                           Text="当前图像尺寸：0 × 0" Margin="0,0,0,10"/>
                <TextBlock Text="DDS格式建议使用2的幂次方尺寸。非标准尺寸可能导致："
                           FontSize="12" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <StackPanel Margin="15,0,0,0">
                    <TextBlock Text="• 在某些游戏引擎中无法正确显示" FontSize="11" Foreground="#FFAAAAAA"/>
                    <TextBlock Text="• 无法生成完整的mipmap链" FontSize="11" Foreground="#FFAAAAAA"/>
                    <TextBlock Text="• 在某些硬件上加载失败" FontSize="11" Foreground="#FFAAAAAA"/>
                </StackPanel>
            </StackPanel>

            <!-- 右侧：预览区域 -->
            <Border Grid.Column="1" Background="#FF252526" BorderBrush="#FF3E3E42"
                    BorderThickness="1" Padding="10" CornerRadius="5" Margin="15,0,0,0">
                <StackPanel Width="140">
                    <TextBlock Text="预览长宽比" FontSize="13" FontWeight="Bold"
                               Foreground="#FF00D1B2" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    
                    <!-- 预览容器 - 固定最大尺寸为120×120 -->
                    <Grid Width="120" Height="120" Margin="0,0,0,10">
                        <!-- 预览图 - 动态宽高 -->
                        <Border x:Name="PreviewBorder" 
                                Background="#FF1E1E1E"
                                BorderBrush="#FF555555" 
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Image x:Name="PreviewImage" Stretch="Fill"/>
                        </Border>
                    </Grid>

                    <!-- 预览信息 -->
                    <TextBlock x:Name="TxtSelectedResolution" FontSize="11" Foreground="White"
                               Text="-" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtScaleInfo" FontSize="10" Foreground="#FFAAAAAA"
                               Text="-" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 选择分辨率 -->
        <Border Grid.Row="1" Background="#FF252526" BorderBrush="#FF3E3E42"
                BorderThickness="1" Padding="12" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="选择目标分辨率" FontSize="14" FontWeight="Bold"
                           Foreground="#FF00D1B2" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtRecommendedHint" FontSize="11" Foreground="#FFAAAAAA"
                           TextWrapping="Wrap" Margin="0,0,0,5"/>
            </StackPanel>
        </Border>

        <!-- 分辨率列表 -->
        <Border Grid.Row="2" Background="#FF252526" BorderBrush="#FF3E3E42"
                BorderThickness="1" CornerRadius="5" Padding="10">
            <ListBox x:Name="ResolutionListBox" 
                     Background="Transparent" 
                     BorderThickness="0"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource ResolutionItemStyle}"
                     SelectionChanged="ResolutionListBox_SelectionChanged">
            </ListBox>
        </Border>

        <!-- 操作按钮 -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnResize" Content="缩放并保存" 
                    Click="BtnResize_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF00C853"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="1" x:Name="BtnContinueAnyway" Content="保存原始分辨率" 
                    Click="BtnContinueAnyway_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFFB74D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2" x:Name="BtnCancel" Content="取消" 
                    Click="BtnCancel_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF44336"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>

