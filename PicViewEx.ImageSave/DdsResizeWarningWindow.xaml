<Window x:Class="PicViewEx.ImageSave.DdsResizeWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DDS尺寸警告 - 选择目标分辨率" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF2D2D30">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ResolutionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF007ACC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF007ACC"/>
                    <Setter Property="BorderBrush" Value="#FF00D1B2"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 警告标题和预览 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：警告信息 -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="⚠ DDS尺寸警告" FontSize="18" FontWeight="Bold"
                           Foreground="#FFFFB74D" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtCurrentSize" FontSize="13" Foreground="White" 
                           Text="当前图像尺寸：0 × 0" Margin="0,0,0,3"/>
                <TextBlock x:Name="TxtAspectRatio" FontSize="12" Foreground="#FFAAAAAA" 
                           Text="长宽比：0:0" Margin="0,0,0,8"/>
                <TextBlock FontSize="11" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,0,0,3">
                    <Run Text="DDS格式建议使用2的幂次方尺寸。"/>
                </TextBlock>
                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#FFFF6B6B" 
                           TextWrapping="Wrap" Margin="0,0,0,5">
                    <Run Text="⚠ 当前尺寸不是2的幂次方！"/>
                </TextBlock>
                <TextBlock Text="非标准尺寸可能导致：" FontSize="11" Foreground="#FFCCCCCC" Margin="0,0,0,3"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="• 游戏引擎中显示异常" FontSize="10" Foreground="#FFAAAAAA"/>
                    <TextBlock Text="• 无法生成完整mipmap" FontSize="10" Foreground="#FFAAAAAA"/>
                    <TextBlock Text="• 某些硬件加载失败" FontSize="10" Foreground="#FFAAAAAA"/>
                </StackPanel>
            </StackPanel>

            <!-- 右侧：预览区域 -->
            <Border Grid.Column="1" Background="#FF252526" BorderBrush="#FF3E3E42"
                    BorderThickness="1" Padding="8" CornerRadius="5" Margin="12,0,0,0">
                <StackPanel Width="120">
                    <TextBlock Text="预览长宽比" FontSize="12" FontWeight="Bold"
                               Foreground="#FF00D1B2" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                    
                    <!-- 预览容器 - 固定最大尺寸为100×100 -->
                    <Grid Width="100" Height="100" Margin="0,0,0,8">
                        <!-- 目标分辨率预览图（底层，无边框） -->
                        <Border x:Name="PreviewBorder" 
                                Background="#FF1E1E1E"
                                BorderBrush="Transparent" 
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Image x:Name="PreviewImage" Stretch="Fill"/>
                        </Border>
                        
                        <!-- 原图分辨率参考框（上层，青色实线，背景透明） -->
                        <Border x:Name="OriginalBorder" 
                                Background="Transparent"
                                BorderBrush="#FF00D1B2" 
                                BorderThickness="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        </Border>
                    </Grid>

                    <!-- 预览信息 -->
                    <TextBlock x:Name="TxtSelectedResolution" FontSize="10" Foreground="White"
                               Text="-" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtScaleInfo" FontSize="9" Foreground="#FFAAAAAA"
                               Text="-" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 选择分辨率 -->
        <Border Grid.Row="1" Background="#FF252526" BorderBrush="#FF3E3E42"
                BorderThickness="1" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="选择目标分辨率" FontSize="13" FontWeight="Bold"
                           Foreground="#FF00D1B2" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtRecommendedHint" FontSize="10" Foreground="#FFAAAAAA"
                           TextWrapping="Wrap" Margin="0,0,0,3"/>
            </StackPanel>
        </Border>

        <!-- 分辨率列表 -->
        <Border Grid.Row="2" Background="#FF252526" BorderBrush="#FF3E3E42"
                BorderThickness="1" CornerRadius="5" Padding="8">
            <ListBox x:Name="ResolutionListBox" 
                     Background="Transparent" 
                     BorderThickness="0"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource ResolutionItemStyle}"
                     SelectionChanged="ResolutionListBox_SelectionChanged">
            </ListBox>
        </Border>

        <!-- 操作按钮 -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：保存原始分辨率（较弱的样式） -->
            <Button Grid.Column="0" x:Name="BtnContinueAnyway" Content="保存原始分辨率" 
                    Click="BtnContinueAnyway_Click"
                    Height="40" FontSize="13" Margin="4">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF4A4A4F"/>
                        <Setter Property="Foreground" Value="#FFAAAAAA"/>
                        <Setter Property="BorderBrush" Value="#FF555555"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" 
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FFFFB74D"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 中间：保存新分辨率（突出的绿色样式） -->
            <Button Grid.Column="1" x:Name="BtnResize" Content="✓ 保存新分辨率" 
                    Click="BtnResize_Click"
                    Height="50" FontSize="15" FontWeight="Bold" Margin="8,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF28A745"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#FF1E7E34"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" 
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FF218838"/>
                                            <Setter TargetName="border" Property="BorderBrush" Value="#FF00C853"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FF1E7E34"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 右侧：取消 -->
            <Button Grid.Column="2" x:Name="BtnCancel" Content="取消" 
                    Click="BtnCancel_Click"
                    Height="40" FontSize="13" Margin="4">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF3E3E42"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#FF555555"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" 
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FFF44336"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>

